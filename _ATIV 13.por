programa {
  funcao inicio() {
    inteiro setor_a, setor_b
    escreva("Quantas peças o setor a produziu: ")
    leia(setor_a)
    escreva("Quantos peças o setor b produziu: ")
    leia(setor_b)
    se( setor_a > setor_b)
    escreva("O Setor A produziu mais\n")  
    senao 
    escreva("O Setor B produziu mais")
   
    
    
    
    
  }
}
//13.Disputa de Produtividade: O setor A e o setor B competem. Peça a
///produção de ambos e exiba qual setor produziu mais peças no dia.